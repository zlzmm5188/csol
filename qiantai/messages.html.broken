}
}catch(error){
console.error('[AI] 错误:',error);
const loadingEl=document.getElementById(loadingId);
if(loadingEl)loadingEl.remove();
addMessage('ai','抱歉，服务暂时不可用，请稍后再试。');
}finally{
chatInput.disabled=false;sendBtn.disabled=false;chatInput.focus();
}
}

function addMessage(type,text,msgId,shouldSave=true){
const id=msgId||'msg-'+Date.now()+'-'+Math.random();
const avatar=type==='ai'?'<img src="img/logo-new.png" alt="Providence" style="width:100%;height:100%;object-fit:contain;">':'<img src="img/user-avatar-default.svg" alt="用户" style="width:100%;height:100%;object-fit:contain;">';
const time=new Date().toLocaleTimeString('zh-CN',{hour:'2-digit',minute:'2-digit'});
const html=`<div class="msg ${type}" id="${id}"><div class="msg-avatar">${avatar}</div><div class="msg-content"><div class="msg-bubble">${text}</div><div class="msg-time">${time}</div></div></div>`;
messagesArea.insertAdjacentHTML('beforeend',html);
setTimeout(()=>{messagesArea.scrollTop=messagesArea.scrollHeight},50);
return id;
}

chatInput.addEventListener('keypress',e=>{
if(e.key==='Enter'&&!e.shiftKey){
e.preventDefault();handleSend();
}
});

