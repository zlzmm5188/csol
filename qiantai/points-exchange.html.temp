<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
<title>积分兑换 - Providence</title>
<link rel="stylesheet" href="styles.css?v=1762816700">
<style>
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{height:100%;overflow:hidden}
body{
    background-image:url('img/8b3b66293a9fdc15641fd8ea6fc88a1d.jpg');
    background-size:cover;background-position:center top 0px;
    background-repeat:no-repeat;position:relative
}
body::before{content:'';position:fixed;inset:0;background:rgba(0,0,0,0.25);z-index:0;pointer-events:none}
body>*{position:relative;z-index:1}

/* 顶部 */
.top{
    background:rgba(14,43,68,0.8);backdrop-filter:blur(20px);
    padding:max(12px,env(safe-area-inset-top)) 16px 20px;
    position:relative;z-index:10;overflow:hidden;
    border-bottom:1px solid rgba(255,255,255,0.1)
}
.top::before{
    content:"";position:absolute;inset:0;
    background:radial-gradient(120% 180% at -10% -20%, rgba(255,255,255,0.1), transparent 65%),
                radial-gradient(140% 160% at 110% -10%, rgba(255,255,255,0.05), transparent 58%);
    pointer-events:none
}
.top-bar{position:relative;z-index:1;display:flex;align-items:center;margin-bottom:16px}
.back-btn{color:#fff;font-size:28px;width:40px;height:40px;display:flex;align-items:center;justify-content:center;cursor:pointer}
.page-title{flex:1;text-align:left;margin-left:clamp(12px,3vw,16px);font-size:clamp(18px,4.5vw,20px);font-weight:700;color:#fff}
.record-btn{color:#fff;font-size:13px;padding:6px 12px;background:rgba(255,255,255,0.15);border-radius:16px;cursor:pointer}

/* 积分卡片 */
.points-card{
    position:relative;z-index:1;
    background:linear-gradient(135deg,rgba(139,92,246,0.25),rgba(124,58,237,0.15));
    backdrop-filter:blur(30px);border-radius:20px;padding:32px 24px;
    border:1px solid rgba(139,92,246,0.3);
    box-shadow:0 8px 32px rgba(139,92,246,0.2);
    text-align:center
}
.points-icon{font-size:48px;margin-bottom:12px}
.points-label{font-size:14px;color:rgba(255,255,255,0.7);margin-bottom:8px}
.points-value{font-size:48px;font-weight:800;color:#fff;text-shadow:0 4px 12px rgba(0,0,0,0.3)}

/* 内容区 */
.main{padding:16px;height:calc(100vh - 240px - 60px);overflow-y:auto;position:relative;z-index:1}

/* 商品网格 */
.goods-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
.good-card{
    background:rgba(255,255,255,0.1);backdrop-filter:blur(20px);
    border-radius:16px;overflow:hidden;
    border:1px solid rgba(255,255,255,0.2);
    cursor:pointer;transition:all 0.3s
}
.good-card:active{transform:scale(0.95)}
.good-img{
    width:100%;aspect-ratio:1;
    background:linear-gradient(135deg,rgba(251,191,36,0.2),rgba(245,158,11,0.1));
    display:flex;align-items:center;justify-content:center;
    font-size:48px
}
.good-info{padding:12px}
.good-name{font-size:14px;font-weight:600;color:#fff;margin-bottom:6px}
.good-points{
    display:flex;align-items:center;justify-content:space-between
}
.points-need{font-size:16px;font-weight:700;color:#a78bfa}
.exchange-btn{
    padding:4px 12px;background:linear-gradient(135deg,#a78bfa,#8b5cf6);
    border-radius:12px;font-size:12px;color:#fff;font-weight:600;
    border:none;cursor:pointer;box-shadow:0 2px 8px rgba(139,92,246,0.3)
}

/* 空状态 */
.empty{
    text-align:center;padding:60px 20px;color:rgba(255,255,255,0.6);
    display:flex;flex-direction:column;align-items:center;gap:12px
}
.empty-icon{font-size:64px;opacity:0.5}
.empty-text{font-size:14px}
</style>
</head>
<body>

<div class="top">
    <div class="top-bar">
        <div class="back-btn" onclick="history.back()">‹</div>
        <div class="page-title">积分兑换</div>
        <div class="record-btn" onclick="location.href='points-record.html'">📋</div>
    </div>

    <div class="points-card">
        <div class="points-icon">⭐</div>
        <div class="points-label">我的积分</div>
        <div class="points-value" id="myPoints">0</div>
    </div>
</div>

<div class="main">
    <div class="goods-grid" id="goodsList">
        <div class="empty">
            <div class="empty-icon">🎁</div>
            <div class="empty-text">暂无可兑换商品</div>
        </div>
    </div>
</div>

<nav class="tabbar">
    <a class="tab" href="index.html"><div class="ico ico-home"></div><div class="txt">首页</div></a>
    <a class="tab" href="market.html"><div class="ico ico-finance"></div><div class="txt">数据</div></a>
    <a class="tab" href="projects.html"><div class="ico ico-market"></div><div class="txt">项目</div></a>
    <a class="tab" href="messages.html"><div class="ico ico-message"></div><div class="txt">消息</div></a>
    <a class="tab" href="profile.html"><div class="ico ico-me"></div><div class="txt">我的</div></a>
</nav>

<script src="ios-toast.js?v=1762816700"></script>
<script>
const API_BASE='https://api.frevix.top';
const token=localStorage.getItem('providence_token')||'';

// 模拟商品数据
const mockGoods=[
    {id:1,name:'10元话费',icon:'📱',points:100},
    {id:2,name:'20元话费',icon:'📱',points:200},
    {id:3,name:'50元话费',icon:'📱',points:500},
    {id:4,name:'爱奇艺月卡',icon:'🎬',points:150},
    {id:5,name:'腾讯视频月卡',icon:'📺',points:150},
    {id:6,name:'优酷月卡',icon:'🎞️',points:150}
];

async function loadPoints(){
    try{
        const response=await fetch(`${API_BASE}/user/points/balance`,{
            headers:{'Content-Type':'application/json','token':token}
        });
        const data=await response.json();
        if(data.code===1&&data.data){
            document.getElementById('myPoints').textContent=data.data.points||0;
        }
    }catch(e){
        console.error('[积分] 加载失败:',e);
    }
}

function renderGoods(){
    const container=document.getElementById('goodsList');
    container.innerHTML=mockGoods.map(item=>`
        <div class="good-card" onclick="exchange(${item.id},${item.points},'${item.name}')">
            <div class="good-img">${item.icon}</div>
            <div class="good-info">
                <div class="good-name">${item.name}</div>
                <div class="good-points">
                    <span class="points-need">${item.points}积分</span>
                    <button class="exchange-btn" onclick="event.stopPropagation();exchange(${item.id},${item.points},'${item.name}')">兑换</button>
                </div>
            </div>
        </div>
    `).join('');
}

function exchange(id,points,name){
    const myPoints=parseInt(document.getElementById('myPoints').textContent||0);
    if(myPoints<points){
        showToast('积分不足','您的积分不足以兑换此商品');
        return;
    }
    if(confirm(`确认兑换【${name}】？\n需要消耗${points}积分`)){
        showToast('兑换成功','商品将在24小时内发放到您的账户');
        setTimeout(loadPoints,1000);
    }
}

loadPoints();
renderGoods();
</script>
</body>
</html>
