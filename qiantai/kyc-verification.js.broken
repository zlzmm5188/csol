}

// 图像预处理（提高识别率）- 增强版
async function preprocessImage(imageData) {
    return new Promise((resolve) => {
        const img = new Image();
        img.onload = function() {
            const canvas = document.createElement('canvas');
            const ctx = canvas.getContext('2d');

            // === 步骤1：放大图像以提高清晰度 ===
            const scale = 3; // 从2倍提升到3倍
            canvas.width = img.width * scale;
            canvas.height = img.height * scale;

            // 使用高质量缩放
            ctx.imageSmoothingEnabled = true;
            ctx.imageSmoothingQuality = 'high';
            ctx.drawImage(img, 0, 0, canvas.width, canvas.height);

            // === 步骤2：获取图像数据 ===
            const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);
            const data = imageData.data;

            // === 步骤3：自适应二值化（更智能的黑白转换）===
            // 先计算平均亮度作为阈值
            let totalBrightness = 0;
            for (let i = 0; i < data.length; i += 4) {
                const gray = data[i] * 0.299 + data[i + 1] * 0.587 + data[i + 2] * 0.114;
                totalBrightness += gray;
            }
            const avgBrightness = totalBrightness / (data.length / 4);
            const threshold = avgBrightness * 0.85; // 动态阈值

            console.log('图像处理 - 平均亮度:', avgBrightness, '阈值:', threshold);

            // === 步骤4：应用自适应二值化 + 去噪 ===
            for (let i = 0; i < data.length; i += 4) {
                // 转为灰度
                const gray = data[i] * 0.299 + data[i + 1] * 0.587 + data[i + 2] * 0.114;

                // 自适应二值化
                let value;
                if (gray > threshold) {
                    value = 255; // 白色背景
                } else {
                    // 对文字部分进行增强
                    value = gray < threshold * 0.7 ? 0 : Math.floor(gray * 0.5);
                }

                data[i] = value;     // R
                data[i + 1] = value; // G
                data[i + 2] = value; // B
                // Alpha通道保持不变
            }

            ctx.putImageData(imageData, 0, 0);

            // === 步骤5：锐化处理（增强边缘）===
            const sharpened = sharpenImage(ctx, canvas.width, canvas.height);

            // === 步骤6：去除噪点 ===
            const denoised = removeNoise(sharpened, canvas.width, canvas.height);

            ctx.putImageData(denoised, 0, 0);

            console.log('✓ 图像预处理完成');

            // 返回处理后的图像
            resolve(canvas.toDataURL('image/png'));
        };
        img.src = imageData;
    });
}

// 锐化图像（增强文字边缘）
function sharpenImage(ctx, width, height) {
    const imageData = ctx.getImageData(0, 0, width, height);
    const data = imageData.data;
    const output = ctx.createImageData(width, height);

    // 锐化卷积核
    const kernel = [
        0, -1, 0,
        -1, 5, -1,
        0, -1, 0
    ];

    for (let y = 1; y < height - 1; y++) {
        for (let x = 1; x < width - 1; x++) {
            let r = 0, g = 0, b = 0;

            for (let ky = -1; ky <= 1; ky++) {
                for (let kx = -1; kx <= 1; kx++) {
                    const idx = ((y + ky) * width + (x + kx)) * 4;
                    const weight = kernel[(ky + 1) * 3 + (kx + 1)];
                    r += data[idx] * weight;
                    g += data[idx + 1] * weight;
                    b += data[idx + 2] * weight;
                }
            }

            const idx = (y * width + x) * 4;
            output.data[idx] = Math.max(0, Math.min(255, r));
            output.data[idx + 1] = Math.max(0, Math.min(255, g));
            output.data[idx + 2] = Math.max(0, Math.min(255, b));
            output.data[idx + 3] = 255;
        }
    }

    return output;
}

// 去除噪点
function removeNoise(imageData, width, height) {
    const data = imageData.data;
    const output = new ImageData(width, height);

    // 中值滤波去噪
    for (let y = 1; y < height - 1; y++) {
        for (let x = 1; x < width - 1; x++) {
            const neighbors = [];

            // 收集周围像素
            for (let dy = -1; dy <= 1; dy++) {
                for (let dx = -1; dx <= 1; dx++) {
                    const idx = ((y + dy) * width + (x + dx)) * 4;
                    neighbors.push(data[idx]);
                }
            }

            // 取中值
            neighbors.sort((a, b) => a - b);
            const median = neighbors[4]; // 中间值

            const idx = (y * width + x) * 4;
            output.data[idx] = median;
            output.data[idx + 1] = median;
            output.data[idx + 2] = median;
            output.data[idx + 3] = 255;
        }
    }

    return output;
}

// 显示OCR调试信息（临时）
function showOCRDebugInfo(text) {
    // 创建或更新调试面板
    let debugPanel = document.getElementById('ocrDebugPanel');
    if (!debugPanel) {
        debugPanel = document.createElement('div');
        debugPanel.id = 'ocrDebugPanel';
        debugPanel.style.cssText = `
            position: fixed;
            top: 60px;
            left: 10px;
            right: 10px;
            max-height: 200px;
            overflow: auto;
            background: rgba(0, 0, 0, 0.9);
            color: #0f0;
            padding: 10px;
            font-size: 11px;
            font-family: monospace;
            border: 2px solid #0f0;
            border-radius: 8px;
            z-index: 9999;
            white-space: pre-wrap;
            word-break: break-all;
        `;
        document.body.appendChild(debugPanel);
    }

    debugPanel.innerHTML = `
        <div style="color: #ff0; font-weight: bold; margin-bottom: 8px;">
            🔍 OCR识别原始文本（点击可关闭）
        </div>
        <div style="border: 1px solid #0f0; padding: 8px; background: rgba(0,50,0,0.5);">
            ${text.replace(/\n/g, '<br>').replace(/ /g, '·')}
        </div>
    `;

    // 点击关闭
    debugPanel.onclick = function() {
        debugPanel.remove();
    };

    // 10秒后自动关闭
    setTimeout(() => {
        if (debugPanel && debugPanel.parentNode) {
            debugPanel.remove();
        }
    }, 10000);
}

// 增强版姓名提取
function extractNameEnhanced(text) {
    console.log('======== 增强版姓名提取 ========');
    console.log('原始文本:', text);

    // 去除所有·符号（OCR经常把空格识别成·）
    text = text.replace(/·/g, '');

    // 先尝试处理带空格的姓名（如：刘 千 洁）
    const textWithoutSpaces = text.replace(/\s+/g, '');  // 移除所有空格的版本

    console.log('处理后文本:', text);
    console.log('无空格文本:', textWithoutSpaces);

    // 常见姓氏（前100个，覆盖85%的人口）
    const commonSurnames = [
        '王', '李', '张', '刘', '陈', '杨', '黄', '赵', '周', '吴',
        '徐', '孙', '朱', '马', '胡', '郭', '林', '何', '高', '梁',
        '郑', '罗', '宋', '谢', '唐', '韩', '曹', '许', '邓', '萧',
        '冯', '曾', '程', '蔡', '彭', '潘', '袁', '于', '董', '余',
        '苏', '叶', '吕', '魏', '蒋', '田', '杜', '丁', '沈', '姜',
        '范', '江', '傅', '钟', '卢', '汪', '戴', '崔', '任', '陆',
        '廖', '姚', '方', '金', '邱', '夏', '谭', '韦', '贾', '邹',
        '石', '熊', '孟', '秦', '阎', '薛', '侯', '雷', '白', '龙',
        '段', '郝', '孔', '邵', '史', '毛', '常', '万', '顾', '赖',
        '武', '康', '贺', '严', '尹', '钱', '施', '牛', '洪', '龚'
    ];

    const excludeWords = [
        '公民', '身份证', '中国', '居民', '出生', '地址', '签发', '有效期', '民族', '性别',
        '签发机关', '长期', '汉族', '住址', '常住', '户口', '省', '市', '县', '区', '镇',
        '村', '街道', '路', '号', '室', '楼', '单元', '栋', '幢', '中华', '人民', '共和国',
        '身份', '证件', '姓名', '编号', '代码', '机关', '有效', '日期', '期限', '男', '女',
        '管名', '管' // 添加常见误识别
    ];

    // 策略0：在无空格版本中查找常见姓氏开头的姓名
    console.log('--- 策略0: 在无空格文本中查找姓名 ---');
    for (let surname of commonSurnames) {
        const regex = new RegExp(surname + '[一-龥]{1,3}', 'g');
        const matches = textWithoutSpaces.match(regex);
        if (matches) {
            console.log(`  找到姓氏"${surname}"的候选:`, matches);
            for (let candidate of matches) {
                if (candidate.length >= 2 && candidate.length <= 4 &&
                    !excludeWords.includes(candidate) &&
                    isValidName(candidate, commonSurnames) &&
                    !isAddressOrKeyword(candidate)) {
                    console.log('✅ 策略0成功（无空格文本）:', candidate);
                    return candidate;
                }
            }
        }
    }

    // 策略1：查找"姓名"或"管名"（误识别）标签后的内容
    let match = text.match(/(?:姓名|管名|名)([刘王李张陈杨黄赵周吴徐孙朱马胡郭林何高梁郑罗宋谢唐韩曹许邓萧冯曾程蔡彭潘袁于董余苏叶吕魏蒋田杜丁沈姜范江傅钟卢汪戴崔任陆廖姚方金邱夏谭韦贾邹石熊孟秦阎薛侯雷白龙段郝孔邵史毛常万顾赖武康贺严尹钱施牛洪龚][一-龥]{1,3})/);
    if (match) {
        const name = match[1].trim();
        if (!excludeWords.includes(name) && isValidName(name, commonSurnames)) {
            console.log('✅ 策略1成功（标签后）:', name);
            return name;
        }
    }

    // 策略2：查找常见姓氏开头的2-4个汉字（排除"姓名"标签干扰）
    for (let surname of commonSurnames) {
        const regex = new RegExp(surname + '[一-龥]{1,3}', 'g');
        const matches = text.match(regex);
        if (matches) {
            console.log(`  找到姓氏"${surname}"的候选:`, matches);
            for (let candidate of matches) {
                // 排除"姓名"标签本身
                if (candidate.length >= 2 && candidate.length <= 4 &&
                    !excludeWords.includes(candidate) &&
                    candidate !== '姓名' &&
                    candidate !== '管名' &&
                    !isAddressOrKeyword(candidate)) {
                    console.log('✅ 策略2成功（常见姓氏）:', candidate);
                    return candidate;
                }
            }
        }
    }

    // 策略3：利用"性别"定位（姓名在性别之前）
    const genderPos = text.search(/性别|女|男/);
    if (genderPos > 0) {
        const beforeGender = text.substring(0, genderPos);
        console.log('性别之前的文本:', beforeGender);

        // 查找常见姓氏
        for (let surname of commonSurnames) {
            const idx = beforeGender.lastIndexOf(surname);
            if (idx >= 0) {
                // 提取姓氏后面的2-4个字
                const afterSurname = beforeGender.substring(idx);
                const nameMatch = afterSurname.match(new RegExp(surname + '[一-龥]{1,3}'));
                if (nameMatch) {
                    const candidate = nameMatch[0];
                    if (candidate.length >= 2 && candidate.length <= 4 &&
                        !excludeWords.includes(candidate)) {
                        console.log('✅ 策略3成功（性别前）:', candidate);
                        return candidate;
                    }
                }
            }
        }
    }

    // 策略4：利用身份证号定位
    const idCardPos = text.search(/\d{17}[\dXx]/);
    if (idCardPos > 0) {
        const beforeId = text.substring(Math.max(0, idCardPos - 50), idCardPos);
        console.log('身份证号前50字:', beforeId);

        const matches = beforeId.match(/[一-龥]{2,4}/g);
        if (matches) {
            console.log('找到的汉字组合:', matches);
            for (let i = matches.length - 1; i >= 0; i--) {
                const candidate = matches[i];
                if (isValidName(candidate, commonSurnames) &&
                    !excludeWords.includes(candidate)) {
                    console.log('✅ 策略4成功（身份证号前）:', candidate);
                    return candidate;
                }
            }
        }
    }

    console.log('❌ 所有策略均未找到有效姓名');
    return null;
}

// 验证是否为有效姓名
function isValidName(name, commonSurnames) {
    if (!name || name.length < 2 || name.length > 4) {
        return false;
    }

    // 检查第一个字是否为常见姓氏
    const firstChar = name.charAt(0);
    if (!commonSurnames.includes(firstChar)) {
        console.log(`  "${name}" 首字"${firstChar}"不是常见姓氏`);
        return false;
    }

    // 检查是否全是同一个字（如"明明明"）
    const allSame = name.split('').every(c => c === firstChar);
    if (allSame && name.length > 2) {
        console.log(`  "${name}" 全是相同的字`);
        return false;
    }

    return true;
}

// 提取姓名（保留原函数作为备用）
function extractName(text) {
    console.log('======== 开始提取姓名 ========');
    console.log('原始文本:', text);
    console.log('文本长度:', text.length);

    // 超级严格的干扰词列表
    const excludeWords = [
        '公民', '身份证', '中国', '居民', '出生', '地址', '签发', '有效期', '民族', '性别',
        '签发机关', '长期', '汉族', '住址', '常住', '户口', '省', '市', '县', '区', '镇',
        '村', '街道', '路', '号', '室', '楼', '单元', '栋', '幢', '中华', '人民', '共和国',
        '身份', '证件', '姓名', '编号', '代码', '机关', '有效', '日期', '期限', '男', '女'
    ];

    // === 策略1：超强"姓名"标签识别 ===
    // 匹配各种可能的格式：
    // "姓名 张三"、"姓名:张三"、"姓名：张三"、"姓 名 张三"、"姓名张三"
    // 匹配"姓"和"名"之间可能有空格、冒号等
    let match = text.match(/姓[\s]*名[\s:：]*([一-龥]{2,4})/);
    if (match) {
        const name = match[1].trim();
        console.log('策略1找到候选（姓名标签后）:', name);
        if (!excludeWords.includes(name) && !isAddressOrKeyword(name)) {
            console.log('✅ 策略1匹配成功:', name);
            return name;
        } else {
            console.log(`❌ 策略1: "${name}" 被过滤`);
        }
    }
    console.log('❌ 策略1未找到');

    // === 策略2：查找"姓名"这两个字后面的内容（更宽松） ===
    // 有时OCR会把整行识别在一起："姓名李四性别"
    const nameTagPos = text.search(/姓[\s]*名/);
    if (nameTagPos >= 0) {
        // 找到"姓名"标签的位置，提取后面的内容
        const afterNameTag = text.substring(nameTagPos + 2); // 跳过"姓名"两个字
        console.log('姓名标签后的文本（前50字）:', afterNameTag.substring(0, 50));

        // 在这段文本中找第一个2-4个连续汉字
        const nameMatch = afterNameTag.match(/^\s*[:：\s]*([一-龥]{2,4})/);
        if (nameMatch) {
            const name = nameMatch[1].trim();
            console.log('策略2找到候选:', name);
            if (!excludeWords.includes(name) && !isAddressOrKeyword(name)) {
                console.log('✅ 策略2匹配成功:', name);
                return name;
            } else {
                console.log(`❌ 策略2: "${name}" 被过滤`);
            }
        }
    }
    console.log('❌ 策略2未找到');

    // === 策略3：利用"性别"定位 ===
    // 身份证格式：姓名 性别 民族
    // 提取"性"字之前最近的2-4个汉字
    const genderPos = text.search(/性[\s]*别/);
    if (genderPos > 0) {
        const beforeGender = text.substring(0, genderPos);
        console.log('性别之前的文本（最后50字）:', beforeGender.substring(Math.max(0, beforeGender.length - 50)));

        // 从后往前找2-4个连续汉字
        const matches = beforeGender.match(/[一-龥]{2,4}/g);
        if (matches && matches.length > 0) {
            console.log('策略3找到的所有候选:', matches);
            // 从最后一个往前查找（最接近"性别"的）
            for (let i = matches.length - 1; i >= 0; i--) {
                const candidate = matches[i];
                if (!excludeWords.includes(candidate) && !isAddressOrKeyword(candidate)) {
                    console.log('✅ 策略3匹配成功（性别前）:', candidate);
                    return candidate;
                }
            }
        }
    }
    console.log('❌ 策略3未找到');

    // === 策略4：利用"民族"定位 ===
    const nationPos = text.search(/民[\s]*族/);
    if (nationPos > 0) {
        const beforeNation = text.substring(0, nationPos);
        console.log('民族之前的文本（最后50字）:', beforeNation.substring(Math.max(0, beforeNation.length - 50)));

        const matches = beforeNation.match(/[一-龥]{2,4}/g);
        if (matches && matches.length > 0) {
            console.log('策略4找到的所有候选:', matches);
            for (let i = matches.length - 1; i >= 0; i--) {
                const candidate = matches[i];
                if (!excludeWords.includes(candidate) && !isAddressOrKeyword(candidate)) {
                    console.log('✅ 策略4匹配成功（民族前）:', candidate);
                    return candidate;
                }
            }
        }
    }
    console.log('❌ 策略4未找到');

    // === 策略5：查找身份证号前面最近的2-4个汉字 ===
    const idCardPos = text.search(/\d{17}[\dXx]/);
    if (idCardPos > 0) {
        const beforeId = text.substring(0, idCardPos);
        console.log('身份证号之前的文本（最后80字）:', beforeId.substring(Math.max(0, beforeId.length - 80)));

        // 只在最近的80字符内查找
        const recentText = beforeId.substring(Math.max(0, beforeId.length - 80));
        const matches = recentText.match(/[一-龥]{2,4}/g);

        if (matches && matches.length > 0) {
            console.log('策略5找到的所有候选:', matches);

            // 从后往前检查
            for (let i = matches.length - 1; i >= 0; i--) {
                const candidate = matches[i];
                console.log(`  检查候选 "${candidate}"`);

                if (!excludeWords.includes(candidate) &&
                    !isAddressOrKeyword(candidate)) {
                    console.log('✅ 策略5匹配成功:', candidate);
                    return candidate;
                }
            }
        }
    }
    console.log('❌ 策略5未找到');

    console.log('======== 所有策略都未匹配到姓名 ========');
    return null;
}

// 判断是否为地址或关键词
function isAddressOrKeyword(text) {
    // 地址关键词
    const addressKeywords = [
        '省', '市', '县', '区', '镇', '乡', '村', '街', '路', '道', '巷', '弄',
        '号', '室', '楼', '层', '单元', '栋', '幢', '座', '门', '牌', '组',
        '自治', '特别', '行政', '地区', '盟', '旗', '苏木'
    ];

    // 身份证常见词
    const idCardKeywords = [
        '身份', '证件', '公民', '居民', '号码', '编号', '代码', '签发', '有效'
    ];

    // 检查地址关键词
    for (let keyword of addressKeywords) {
        if (text.includes(keyword)) {
            console.log(`  "${text}" 包含地址关键词: ${keyword}`);
            return true;
        }
    }

    // 检查身份证关键词
    for (let keyword of idCardKeywords) {
        if (text.includes(keyword)) {
            console.log(`  "${text}" 包含身份证关键词: ${keyword}`);
            return true;
        }
    }

    // 超过4个字通常不是姓名
    if (text.length > 4) {
        console.log(`  "${text}" 长度超过4`);
        return true;
    }

    return false;
}

// 提取身份证号
function extractIdCard(text) {
    // 移除所有空格
    const noSpace = text.replace(/\s+/g, '');

    // 匹配18位身份证号
    const match = noSpace.match(/(\d{17}[\dXx])/);
    if (match) {
        return match[1].toUpperCase();
    }

    return null;
}

// 前往步骤2
function goToStep2() {
    const name = document.getElementById('nameInput').value.trim();
    const idCard = document.getElementById('idCardInput').value.trim();

    // 验证
    if (!kycData.idCardImage) {
        showToast('请先上传身份证照片');
        return;
    }

    if (!name) {
        showToast('请输入真实姓名');
        return;
    }

    if (name.length < 2) {
        showToast('请输入正确的姓名');
        return;
    }

    if (!idCard) {
        showToast('请输入身份证号');
        return;
    }

    if (!/^[1-9]\d{5}(18|19|20)\d{2}(0[1-9]|1[0-2])(0[1-9]|[12]\d|3[01])\d{3}[\dXx]$/.test(idCard)) {
        showToast('请输入正确的身份证号');
        return;
    }

    // 保存数据
    kycData.realname = name;
    kycData.idCard = idCard;

    // 切换步骤
    document.getElementById('step1').classList.add('hidden');
    document.getElementById('step2').classList.remove('hidden');
    document.getElementById('dot1').classList.remove('active');
    document.getElementById('dot2').classList.add('active');

    window.scrollTo({ top: 0, behavior: 'smooth' });
}

// 返回步骤1
function goBackToStep1() {
    // 停止摄像头
    if (videoStream) {
        videoStream.getTracks().forEach(track => track.stop());
        videoStream = null;
    }

    document.getElementById('step2').classList.add('hidden');
    document.getElementById('step1').classList.remove('hidden');
    document.getElementById('dot2').classList.remove('active');
    document.getElementById('dot1').classList.add('active');

    // 重置人脸识别状态
    document.getElementById('cameraView').classList.add('hidden');
    document.getElementById('capturePlaceholder').classList.remove('hidden');
    document.getElementById('captureBtn').classList.add('hidden');

    window.scrollTo({ top: 0, behavior: 'smooth' });
}

// 启动摄像头
async function startCamera() {
    try {
        const constraints = {
            video: {
                facingMode: 'user',
                width: { ideal: 640 },
                height: { ideal: 480 }
            },
            audio: false
        };

        videoStream = await navigator.mediaDevices.getUserMedia(constraints);
        const video = document.getElementById('faceVideo');
        video.srcObject = videoStream;

        document.getElementById('capturePlaceholder').classList.add('hidden');
        document.getElementById('cameraView').classList.remove('hidden');
        document.getElementById('captureBtn').classList.remove('hidden');

    } catch (error) {
        console.error('摄像头启动失败:', error);
        showToast('无法访问摄像头，请检查权限');
    }
}

// 拍摄人脸照片
async function captureFace() {
    const video = document.getElementById('faceVideo');
    const canvas = document.getElementById('canvas');

    canvas.width = video.videoWidth;
    canvas.height = video.videoHeight;

    const ctx = canvas.getContext('2d');
    ctx.drawImage(video, 0, 0);

    kycData.faceImage = canvas.toDataURL('image/jpeg', 0.85);

    // 停止摄像头
    if (videoStream) {
        videoStream.getTracks().forEach(track => track.stop());
        videoStream = null;
    }

    // 隐藏摄像头
    document.getElementById('cameraView').classList.add('hidden');
    document.getElementById('captureBtn').classList.add('hidden');

    // 进行真实的人脸比对
    showToast('正在进行人脸比对验证...');

    try {
        // 调用后端人脸比对API
        const apiUrl = TEST_MODE ? TEST_API_URL : API_BASE + '/api/face/verifyFace';
        console.log('调用接口:', apiUrl, '测试模式:', TEST_MODE);

        const response = await fetch(apiUrl, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'token': kycData.token
            },
            body: JSON.stringify({
                id_card_image: kycData.idCardImage,  // 身份证照片
                face_image: kycData.faceImage,       // 自拍照片
                realname: kycData.realname,
                id_card: kycData.idCard
            })
        });

        const data = await response.json();
        console.log('人脸比对结果:', data);

        if (data.code === 200 && data.data) {
            const similarity = data.data.similarity || 0;
            const passed = data.data.passed || false;

            // 显示结果
            document.getElementById('faceResult').classList.remove('hidden');
            document.getElementById('similarityText').textContent = similarity.toFixed(1) + '%';

            // 实名认证场景：设置更严格的相似度阈值（80%以上才通过）
            // 因为是身份证照片 vs 自拍，必须是本人才能通过
            const THRESHOLD = 80;  // 严格阈值

            if (passed && similarity >= THRESHOLD) {
                document.getElementById('submitBtn').classList.remove('hidden');
                showToast(`✓ 人脸验证通过（相似度: ${similarity.toFixed(1)}%）`);
            } else {
                // 验证未通过
                document.getElementById('faceResult').style.borderColor = '#f44336';
                document.getElementById('faceResult').style.background = 'rgba(244, 67, 54, 0.1)';

                let errorMsg = `❌ 人脸验证失败（相似度: ${similarity.toFixed(1)}%）\n`;
                if (similarity < 60) {
                    errorMsg += '相似度过低，请确认：\n1. 是否使用本人身份证\n2. 光线是否充足\n3. 面部是否完整清晰';
                } else if (similarity < THRESHOLD) {
                    errorMsg += `相似度不足${THRESHOLD}%，为了您的账户安全，请重新拍摄\n建议：摘掉眼镜、保持光线充足`;
                } else {
                    errorMsg += '请使用本人身份证进行认证';
                }

                showToast(errorMsg);

                // 3秒后允许重新拍摄
                setTimeout(() => {
                    document.getElementById('faceResult').classList.add('hidden');
                    document.getElementById('capturePlaceholder').classList.remove('hidden');
                }, 3000);
            }
        } else {
            // 比对失败
            showToast('❌ ' + (data.msg || '人脸比对失败，请重试'));
            setTimeout(() => {
                document.getElementById('capturePlaceholder').classList.remove('hidden');
            }, 2000);
        }
    } catch (error) {
        console.error('人脸比对错误:', error);
        showToast('❌ 人脸比对服务异常，请稍后重试');
        setTimeout(() => {
            document.getElementById('capturePlaceholder').classList.remove('hidden');
        }, 2000);
    }
}

// 提交认证
async function submitKYC() {
    const submitBtn = document.getElementById('submitBtn');
    submitBtn.disabled = true;
    submitBtn.innerHTML = '<span class="loading"></span>提交中...';

    try {
        const apiUrl = TEST_MODE ? TEST_API_URL : API_BASE + '/api/kyc/submit';
        console.log('提交认证到:', apiUrl);

        const response = await fetch(apiUrl, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'token': kycData.token
            },
            body: JSON.stringify({
                realname: kycData.realname,
                id_card: kycData.idCard,
                id_card_image: kycData.idCardImage,
                selfie_image: kycData.faceImage
            })
        });

        const data = await response.json();

        if (data.code === 200) {
            showToast('✅ 实名认证成功！');
            localStorage.setItem('providence_user_name', kycData.realname);
            localStorage.setItem('kyc_verified', 'true');

            setTimeout(() => {
                window.location.href = 'index.html';
            }, 2000);
        } else {
            showToast(data.msg || '认证失败，请重试');
            submitBtn.disabled = false;
            submitBtn.textContent = '提交认证';
        }
    } catch (error) {
        console.error('提交失败:', error);
        showToast('网络错误，请重试');
        submitBtn.disabled = false;
        submitBtn.textContent = '提交认证';
    }
}

// Toast提示
function showToast(message) {
    // 移除旧toast
    const oldToast = document.querySelector('.toast');
    if (oldToast) oldToast.remove();

    const toast = document.createElement('div');
    toast.className = 'toast';
    toast.textContent = message;
    document.body.appendChild(toast);

    setTimeout(() => {
        if (toast.parentNode) {
            toast.remove();
        }
    }, 3000);
}

// 页面卸载时停止摄像头
window.addEventListener('beforeunload', function() {
    if (videoStream) {
        videoStream.getTracks().forEach(track => track.stop());
    }
});

// 使用简单OCR识别身份证号（只识别数字）
async function recognizeIdCardNumber(imageData) {
    try {
        console.log('=== 尝试识别身份证号 ===');
        showToast('正在识别身份证号...');
        
        // 调用后端简单OCR接口
        const response = await fetch('https://4kp3l0iq.top/simple-ocr.php', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                image: imageData
            })
        });
        
        const result = await response.json();
        console.log('识别结果:', result);
        
        if (result.code === 200 && result.data && result.data.id_card) {
            // 自动填写身份证号
            document.getElementById('idCardInput').value = result.data.id_card;
            kycData.idCard = result.data.id_card;
            showToast('✓ 身份证号已自动识别');
            
            // 提示填写姓名
            setTimeout(() => {
                showToast('请填写真实姓名');
                document.getElementById('nameInput').focus();
            }, 1500);
        } else {
            // 识别失败，提示手动输入
            showToast('请手动填写姓名和身份证号');
        }
        
    } catch (error) {
        console.error('识别错误:', error);
        showToast('请手动填写姓名和身份证号');
    }
}
