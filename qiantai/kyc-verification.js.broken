// 页面加载
document.addEventListener('DOMContentLoaded', function() {
    console.log('=== 页面加载完成 ===');
    console.log('当前URL:', window.location.href);

    const token = localStorage.getItem('providence_token');
    const userId = localStorage.getItem('providence_user_id');

    console.log('Token:', token ? '存在' : '不存在');
    console.log('UserId:', userId);

    if (!token || !userId) {
        console.log('❌ 未登录，准备跳转到登录页');
        showToast('请先登录');
        setTimeout(() => window.location.href = 'login.html', 1500);
        return;
    }

    kycData.token = token;
    kycData.userId = userId;

    // 绑定上传事件
    const idInput = document.getElementById('idInput');
    const uploadArea = document.getElementById('uploadArea');

    console.log('找到 idInput 元素:', idInput ? '是' : '否', idInput);
    console.log('找到 uploadArea 元素:', uploadArea ? '是' : '否', uploadArea);

    if (idInput) {
        // 方法1：通过 addEventListener
        idInput.addEventListener('change', function(e) {
            console.log('🔥 change 事件触发！');
            handleIdUpload(e);
        });
        console.log('✓ 已绑定 change 事件（addEventListener）');

        // 方法2：直接赋值（备用）
        idInput.onchange = function(e) {
            console.log('🔥 onchange 事件触发！');
            handleIdUpload(e);
        };
        console.log('✓ 已绑定 onchange 事件（直接赋值）');

    } else {
        console.error('❌ 未找到 idInput 元素！');
    }

    // 测试点击事件
    if (uploadArea) {
        uploadArea.addEventListener('click', function(e) {
            console.log('🔥 上传区域被点击！');
            console.log('点击事件目标:', e.target);
            console.log('准备触发文件选择...');

            // 确保触发 input
            if (idInput) {
                console.log('手动触发 idInput.click()');
                idInput.click();
            } else {
                console.error('❌ idInput 不存在，无法触发！');
            }
        });
        console.log('✓ 已绑定上传区域点击事件');
    } else {
        console.error('❌ 未找到 uploadArea 元素！');
    }

    console.log('=== 初始化完成 ===');
});

// 处理身份证上传
function handleIdUpload(event) {
    console.log('=== handleIdUpload 被调用 ===');
    console.log('Event:', event);
    console.log('Files:', event.target.files);

    const file = event.target.files[0];
    if (!file) {
        console.log('❌ 没有选择文件');
        return;
    }

    console.log('✓ 文件信息:', {
        name: file.name,
        size: file.size,
        type: file.type
    });

    const reader = new FileReader();
    reader.onload = function(e) {
        console.log('✓ 文件读取完成');
        kycData.idCardImage = e.target.result;

        // 更新UI
        const uploadArea = document.getElementById('uploadArea');
        const placeholder = document.getElementById('uploadPlaceholder');
        const success = document.getElementById('uploadSuccess');

        uploadArea.classList.add('uploaded');
        placeholder.classList.add('hidden');
        success.classList.remove('hidden');

        showToast('✓ 身份证已上传');
        console.log('✓ UI 已更新');

        // 尝试识别身份证号（只识别数字）
        setTimeout(() => {
            console.log('尝试识别身份证号...');
            recognizeIdCardNumber(e.target.result);
        }, 500);
    };

    reader.onerror = function(error) {
        console.error('文件读取失败:', error);
        showToast('❌ 文件读取失败');
    };

    console.log('开始读取文件...');
    reader.readAsDataURL(file);
}

// OCR识别身份证（使用 Puter.js - 免费无限次）
async function recognizeIdCard(imageData) {
    try {
        console.log('=== 开始 Puter.js OCR识别 ===');
        
        showToast('正在智能识别身份证信息...');
        
        // 调用 Puter.js OCR API
        const text = await puter.ai.img2txt(imageData);
        
        console.log('✓ Puter.js OCR识别完成');
        console.log('识别文本:', text);
        
        if (!text || text.trim().length === 0) {
            console.log('❌ 未识别到文字');
            showToast('⚠️ 未识别到文字，请手动输入');
            return;
        }
        
        // 提取身份证号
        const idCard = extractIdCard(text);
        if (idCard) {
            console.log('✓ 提取到身份证号:', idCard);
            document.getElementById('idCardInput').value = idCard;
            kycData.idCard = idCard;
        } else {
            console.log('❌ 未找到身份证号');
        }
        
        // 提取姓名
        const name = extractNameEnhanced(text);
        if (name) {
            console.log('✓ 提取到姓名:', name);
            document.getElementById('nameInput').value = name;
            kycData.realname = name;
        } else {
            console.log('❌ 未找到姓名');
        }
        
        if (idCard || name) {
            showToast('✓ 识别成功！请确认信息');
        } else {
            showToast('⚠️ 识别不完整，请手动补充');
        }
        
    } catch (error) {
        console.error('OCR识别错误:', error);
        showToast('❌ 识别失败，请手动输入');
    }
}

