    <script src="config.js?v=1763365509"></script>
    <script src="custom-modal.js?v=1762754400"></script>
    <script src="ios-toast.js?v=1762754400"></script>
    <script src="profile.js?v=1763378502"></script>
    <script>
      // 所有卡片翻转功能（点击翻转，状态持久化）
      document.addEventListener("DOMContentLoaded", function () {
        const flipCards = document.querySelectorAll(".flip-card");

        flipCards.forEach((card) => {
          const flipId = card.dataset.flipId;
          if (!flipId) return;

          // USDT卡片特殊处理：三态循环（余额 -> 收益 -> 空白 -> 余额）
          if (flipId === "usdt") {
            const usdtCard = card;
            let currentState = "balance"; // balance, income, empty

            // 从localStorage恢复状态
            const savedState = localStorage.getItem("flip_card_usdt_state");
            if (savedState) {
              currentState = savedState;
            } else {
              // 默认显示余额
              currentState = "balance";
            }

            // 更新显示状态
            function updateUsdtDisplay() {
              const balanceEl = usdtCard.querySelector(
                '[data-usdt-state="balance"]'
              );
              const incomeEl = usdtCard.querySelector(
                '[data-usdt-state="income"]'
              );
              const emptyEl = usdtCard.querySelector(
                '[data-usdt-state="empty"]'
              );

              // 重置所有状态
              if (balanceEl) {
                balanceEl.style.opacity = "0";
                balanceEl.style.pointerEvents = "none";
              }
              if (incomeEl) {
                incomeEl.style.opacity = "0";
                incomeEl.style.pointerEvents = "none";
              }
              if (emptyEl) {
                emptyEl.style.opacity = "0";
                emptyEl.style.pointerEvents = "none";
              }

              // 显示当前状态
              if (currentState === "balance" && balanceEl) {
                balanceEl.style.opacity = "1";
                balanceEl.style.pointerEvents = "auto";
              } else if (currentState === "income" && incomeEl) {
                incomeEl.style.opacity = "1";
                incomeEl.style.pointerEvents = "auto";
              } else if (currentState === "empty" && emptyEl) {
                emptyEl.style.opacity = "1";
                emptyEl.style.pointerEvents = "auto";
              }
            }

            // 初始化显示
            updateUsdtDisplay();

            // 点击切换状态：余额 -> 收益 -> 空白 -> 余额
            usdtCard.addEventListener("click", function () {
              if (currentState === "balance") {
                currentState = "income";
              } else if (currentState === "income") {
                currentState = "empty";
              } else if (currentState === "empty") {
                currentState = "balance";
              }
              updateUsdtDisplay();
              localStorage.setItem("flip_card_usdt_state", currentState);
            });

            // 监听USDT收益数据更新
            function updateUsdtIncomeDisplay() {
              const incomeEl = usdtCard.querySelector("#totalUsdtIncome");
              if (incomeEl) {
                const totalIncomeUsdtEl =
                  document.getElementById("totalIncomeUsdt");
                if (totalIncomeUsdtEl) {
                  const value = parseFloat(
                    totalIncomeUsdtEl.textContent || "0"
                  );
                  incomeEl.textContent = value.toFixed(2);
                  // 如果金额为0，使用白色；否则使用绿色
                  if (value === 0) {
                    incomeEl.style.color = "#ffffff";
                  } else {
                    incomeEl.style.color = "#4ade80";
                  }
                } else {
                  // 如果没有totalIncomeUsdt元素，直接显示0.00
                  incomeEl.textContent = "0.00";
                  incomeEl.style.color = "#ffffff";
                }
              }
            }

            const observer = new MutationObserver(function () {
              updateUsdtIncomeDisplay();
            });
            const totalIncomeUsdtEl =
              document.getElementById("totalIncomeUsdt");
            if (totalIncomeUsdtEl) {
              observer.observe(totalIncomeUsdtEl, {
                childList: true,
                characterData: true,
                subtree: true,
              });
              // 初始化USDT收益显示
              updateUsdtIncomeDisplay();
            } else {
              // 如果没有totalIncomeUsdt元素，也初始化显示
              updateUsdtIncomeDisplay();
            }
            return;
          }

          // 其他卡片：普通翻转
          const inner = card.querySelector(".flip-card-inner");
          if (!inner) return;

          // 从localStorage恢复翻转状态
          const savedState = localStorage.getItem(`flip_card_${flipId}`);
          const isFlipped = savedState === "flipped";

          if (isFlipped) {
            inner.style.transform = "rotateX(180deg)";
          }

          // 点击翻转
          card.addEventListener("click", function () {
            const currentTransform = inner.style.transform;
            const isCurrentlyFlipped = currentTransform === "rotateX(180deg)";

            if (isCurrentlyFlipped) {
              inner.style.transform = "rotateX(0deg)";
              localStorage.setItem(`flip_card_${flipId}`, "normal");
            } else {
              inner.style.transform = "rotateX(180deg)";
              localStorage.setItem(`flip_card_${flipId}`, "flipped");
            }
          });
        });
      });

      async function handleLogout() {
        const ok = await customConfirm("确定退出登录吗？", "退出登录");
        if (ok) {
          localStorage.removeItem("providence_token");
          window.location.href = "login.html";
        }
      }
    </script>
  </body>
</html>
