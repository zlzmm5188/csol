// Providence 数据库 Schema
// 生成时间: 2025-11-08

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 用户表
model User {
  id            Int             @id @default(autoincrement())
  uid           String          @unique @db.VarChar(50)
  phone         String          @unique @db.VarChar(20)
  password      String          @db.VarChar(255)
  username      String?         @db.VarChar(50)
  realname      String?         @db.VarChar(50)
  email         String?         @db.VarChar(100)
  avatar        String?         @db.VarChar(255)

  // 财务信息
  money         Decimal         @default(0) @db.Decimal(10, 2)
  recharges     Decimal         @default(0) @db.Decimal(10, 2)
  withdraws     Decimal         @default(0) @db.Decimal(10, 2)

  // VIP信息
  vipLevel      Int             @default(0) @db.TinyInt

  // 实名认证
  kycStatus     Int             @default(0) @db.TinyInt // 0=未认证, 1=审核中, 2=已认证
  idcard        String?         @db.VarChar(50)

  // 邀请信息
  inviteCode    String?         @unique @db.VarChar(20)
  pid           Int             @default(0) // 邀请人ID

  // 时间戳
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // 关系
  orders        Order[]
  inviteLogs    InviteLog[]
  signLogs      DailySignLog[]
  teamBonusLogs TeamBonusLog[]
  kycRecords    KycRecord[]

  @@map("fa_user")
}

// VIP等级配置
model VipLevel {
  id            Int      @id @default(autoincrement())
  level         Int      @unique @db.TinyInt // 0~8
  name          String   @db.VarChar(20) // VIP0, VIP1...VIP8
  investAmount  Decimal  @db.Decimal(10, 2) // 累计投资额要求
  interestAdd   Decimal  @db.Decimal(5, 2) // VIP加息 例如：0.6 = +0.6%
  commissionL1  Decimal  @default(0) @db.Decimal(5, 2) // 一级返佣比例
  commissionL2  Decimal  @default(0) @db.Decimal(5, 2) // 二级返佣比例

  createdAt     DateTime @default(now())

  @@map("fa_vip_config")
}

// 投资产品
model Product {
  id            Int       @id @default(autoincrement())
  title         String    @db.VarChar(100)
  subtitle      String?   @db.VarChar(200)
  category      String    @db.VarChar(20) // ipo / bond / fund / convertible

  // 收益参数
  baseAPR       Decimal   @db.Decimal(5, 2) // 基础年化 例如9.2就是9.2%
  cycleDays     Int       // 投资周期（天）
  minInvest     Int       // 起投金额（人民币）

  // 募集信息
  totalAmount   Int?      // 总募集金额
  raisedAmount  Int       @default(0) // 已募集金额

  // 状态
  status        String    @default("open") @db.VarChar(20) // open / close / finish

  // 项目经理
  managerId     Int?      // 关联项目经理

  // 策略文案（新增）
  strategyMd    String?   @db.Text // 最终展示的策略文案（Markdown，可覆盖）
  strategyTplId Int?      // 选中的模板ID
  riskStyle     String?   @db.VarChar(50) // lowdd | balanced | aggressive
  keywords      String?   @db.VarChar(255) // 逗号分隔关键字

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // 关系
  orders        Order[]
  strategyUses  ProductStrategyUse[]

  @@map("fa_fund_project")
}

// 认购订单
model Order {
  id                Int       @id @default(autoincrement())
  orderNo           String    @unique @db.VarChar(50)

  userId            Int
  productId         Int

  // 认购信息
  amount            Decimal   @db.Decimal(10, 2) // 用户认购金额
  aprFinal          Decimal   @db.Decimal(5, 2) // 最终年化 = baseAPR + vip加息
  cycleDays         Int       // 投资周期
  estimatedEarning  Decimal   @db.Decimal(10, 2) // 预计收益

  // 状态
  status            String    @default("active") @db.VarChar(20) // active / finished / cancelled

  // 时间
  startDate         DateTime  @default(now())
  endDate           DateTime?
  createdAt         DateTime  @default(now())

  // 关系
  user              User      @relation(fields: [userId], references: [id])
  product           Product   @relation(fields: [productId], references: [id])

  @@map("fa_fund_order")
}

// 邀请记录
model InviteLog {
  id            Int      @id @default(autoincrement())
  userId        Int      // 邀请人ID
  invitedUid    String   @db.VarChar(50) // 被邀请人UID
  invitedId     Int?     // 被邀请人ID（注册后）
  level         Int      @default(1) @db.TinyInt // 1=一级, 2=二级

  createdAt     DateTime @default(now())

  // 关系
  user          User     @relation(fields: [userId], references: [id])

  @@map("fa_invite_log")
}

// 团队奖金记录
model TeamBonusLog {
  id            Int      @id @default(autoincrement())
  userId        Int
  teamSize      Int      // 团队人数
  investSum     Decimal  @db.Decimal(12, 2) // 团队总投资
  bonus         Decimal  @db.Decimal(10, 2) // 奖金金额
  bonusType     String   @db.VarChar(20) // commission_l1 / commission_l2

  createdAt     DateTime @default(now())

  // 关系
  user          User     @relation(fields: [userId], references: [id])

  @@map("fa_team_bonus_log")
}

// 每日签到记录
model DailySignLog {
  id            Int      @id @default(autoincrement())
  userId        Int
  vipLevel      Int      @db.TinyInt
  points        Int      // 获得积分

  signDate      DateTime @default(now()) @db.Date
  createdAt     DateTime @default(now())

  // 关系
  user          User     @relation(fields: [userId], references: [id])

  @@map("fa_daily_sign_log")
  @@unique([userId, signDate])
}

// 实名认证记录
model KycRecord {
  id            Int      @id @default(autoincrement())
  userId        Int

  // 认证信息
  realname      String   @db.VarChar(50)
  idcard        String   @db.VarChar(50)
  faceImage     String?  @db.Text // 人脸照片URL
  idcardFront   String?  @db.Text // 身份证正面
  idcardBack    String?  @db.Text // 身份证反面

  // 状态
  status        Int      @default(0) @db.TinyInt // 0=待审核, 1=审核中, 2=已通过, 3=已拒绝
  rejectReason  String?  @db.Text

  // 时间
  submittedAt   DateTime @default(now())
  reviewedAt    DateTime?

  // 关系
  user          User     @relation(fields: [userId], references: [id])

  @@map("fa_user_kyc")
}

// 体验金记录
model TrialMoney {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  amount        Decimal  @default(10000) @db.Decimal(10, 2)
  status        String   @default("unclaimed") @db.VarChar(20) // unclaimed / claimed / used

  claimedAt     DateTime?
  createdAt     DateTime @default(now())

  @@map("fa_trial_money")
}

// 用户团队关系
model UserTeam {
  id            Int      @id @default(autoincrement())
  userId        Int      // 上级用户ID
  memberId      Int      // 下级成员ID
  level         Int      @db.TinyInt // 1=一级, 2=二级

  createdAt     DateTime @default(now())

  @@unique([userId, memberId])
  @@map("fa_user_team")
}

// ========== 策略文案库系统 ==========

// 策略模板主表
model StrategyTemplate {
  id          Int       @id @default(autoincrement())
  key         String    @unique @db.VarChar(100) // 模板唯一键，如 "bond_lowdd_core"
  title       String    @db.VarChar(200) // 模板标题（后台可见）
  language    String    @default("zh-CN") @db.VarChar(10)
  category    String    @db.VarChar(20) // ipo | bond | fund | general
  tags        String?    @db.VarChar(255) // 逗号分隔，如 "低回撤,量化择券,稳健"
  bodyMd      String    @db.Text // Markdown 正文，支持变量占位
  isActive    Boolean   @default(true)
  useCount    Int       @default(0) // 被引用次数（用于推荐/A/B）

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // 关系
  variants    StrategyTemplateVariant[]
  productUses ProductStrategyUse[]

  @@map("fa_strategy_template")
  @@index([category, isActive])
  @@index([language, category])
}

// 策略模板变体（A/B测试或多语言/多风格）
model StrategyTemplateVariant {
  id          Int       @id @default(autoincrement())
  templateId  Int
  variantKey  String    @db.VarChar(50) // 如 "A" | "B" | "zh-CN" | "en-US"
  weight      Int       @default(1) // 选择权重
  bodyMd      String    @db.Text
  isActive    Boolean   @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // 关系
  template    StrategyTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@map("fa_strategy_template_variant")
  @@unique([templateId, variantKey])
  @@index([templateId, isActive])
}

// 产品与模板的绑定关系（审计追踪）
model ProductStrategyUse {
  id          Int       @id @default(autoincrement())
  productId   Int
  templateId  Int
  variantId   Int?      // 选中的变体ID
  chosenTags  String?   @db.VarChar(255) // 实际匹配到的标签快照

  createdAt   DateTime  @default(now())

  // 关系
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  template    StrategyTemplate @relation(fields: [templateId], references: [id])

  @@map("fa_product_strategy_use")
  @@index([productId])
  @@index([templateId])
}
